# COMPOSTELLE — environment template.
# Copy to `.env` and fill in. NEVER commit real values (.env is gitignored).
#
# Durable persistence (Supabase / PostgreSQL). When both are set, the app uses
# Supabase as the authoritative source of truth; when unset, it degrades to the
# localStorage cache only. The anon key is a public, RLS-guarded key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# USE grammar correction (issue #5). URL of a self-hosted LanguageTool
# /v2/check endpoint (free, open-source: run `languagetool` via Docker).
# When unset, the USE step falls back to a deterministic surface-level check.
# Example: https://languagetool.your-domain.fr/v2/check
VITE_LANGUAGETOOL_URL=
