# COMPOSTELLE — environment template.
# Copy to `.env` and fill in. NEVER commit real values (.env is gitignored).
#
# Durable persistence (Supabase / PostgreSQL). When both are set, the app uses
# Supabase as the authoritative source of truth; when unset, it degrades to the
# localStorage cache only. The anon key is a public, RLS-guarded key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
